{
	"name": "scripts",
	"private": true,
	"type": "module",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"format": "prettier --write --ignore-unknown --list-different .",
		"clean": "rm -rf node_modules"
	},
	"devDependencies": {
		"@packages/prettier-config": "workspace:*",
		"prettier-plugin-sh": "0.19.0"
	},
	"lint-staged": {
		"*.{json,yml,yaml,md}": "prettier --write --list-different --ignore-unknown"
	}
}
